<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Grid.Resources>
 <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#172535" Padding="18,24,18,18">
  <Grid RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,0,0,12"><Border Width="36" Height="36" CornerRadius="12" Background="#07968B"><TextBlock Text="F" FontSize="23" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel x:Name="BrandLabel"><TextBlock Text="FlowVPN" FontSize="23" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Ваш маршрут в интернете" FontSize="11" Foreground="#9EB2C6" Margin="0,1,0,0"/></StackPanel></StackPanel>
   <TextBlock x:Name="ProfilesCaption" Grid.Row="1" Text="ПРОФИЛИ" FontSize="11" FontWeight="SemiBold" Foreground="#9EB2C6" Margin="8,0,0,0"/>
   <ListView x:Name="ProfileList" Grid.Row="2" SelectionMode="Single" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" RequestedTheme="Dark"/>
   <StackPanel Grid.Row="3" Spacing="8"><Button x:Name="NewProfile" HorizontalAlignment="Stretch" Background="#25394D" Foreground="White" BorderBrush="#355069" CornerRadius="9" Padding="12,10"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock x:Name="NewProfileText" Text="Новый профиль"/></StackPanel></Button><Button x:Name="SettingsButton" HorizontalAlignment="Stretch" Background="#25394D" Foreground="White" BorderThickness="0" CornerRadius="9" Padding="12,10" ToolTipService.ToolTip="Настройки приложения"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock x:Name="SettingsText" Text="Настройки"/></StackPanel></Button></StackPanel>
   <StackPanel x:Name="SidebarFooter" Grid.Row="4" Spacing="10" Margin="6,8,0,0"><Button x:Name="ThemeButton" Content="◐  Системная тема" Background="Transparent" BorderThickness="0" Foreground="#9EB2C6" FontSize="12" Padding="0,6"/><TextBlock x:Name="EngineVersionLabel" Text="sing-box · WinUI 3" FontSize="11" Foreground="#8097AD"/></StackPanel>
  </Grid>
 </Border>
 <ScrollViewer x:Name="MainScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><Grid x:Name="MainArea" Padding="28,24,28,16" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="ScopeCaption" Text="ВЫБРАННЫЙ ПРОФИЛЬ" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ProfileHeading" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="BaseBadge" Grid.Column="1" VerticalAlignment="Center" CornerRadius="18" Padding="12,8" Background="#E2F3EF" Foreground="#007C6F" BorderThickness="0" ToolTipService.ToolTip="Общая настройка для всех профилей"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE73E;" FontSize="12"/><TextBlock x:Name="BaseBadgeText" Text="База включена" FontSize="12"/></StackPanel></Button></Grid>
  <Border x:Name="ConnectionCard" Grid.Row="1" Style="{StaticResource Card}"><Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="10"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#8291A3"/><TextBlock x:Name="StatusText" Text="Отключено" FontSize="21" FontWeight="SemiBold"/><ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/></StackPanel><TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" Text="Подключение запускается вручную"/></StackPanel><Button x:Name="ConnectButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" CornerRadius="10" MinWidth="142" Height="42" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7E8;" FontSize="15"/><TextBlock x:Name="ConnectText" Text="Подключить"/></StackPanel></Button></Grid>
   <Grid x:Name="SourceGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="Подключение" Style="{StaticResource Muted}"/><ComboBox x:Name="SourceCombo" Grid.Row="1" HorizontalAlignment="Stretch" MinWidth="0" CornerRadius="8" PlaceholderText="Выберите OpenVPN или Outline"/><Button x:Name="ApplyButton" Grid.Row="1" Grid.Column="1" Content="Переподключить" CornerRadius="8" ToolTipService.ToolTip="Подключиться с выбранным профилем и сохранёнными правилами"/></Grid>
   <InfoBar x:Name="PendingInfo" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Informational" Message="Изменения сохранены. Переподключитесь, чтобы применить их."/>
  </Grid></Border>
  <NavigationView x:Name="SectionNavigation" Grid.Row="2" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" AlwaysShowHeader="False" SelectionFollowsFocus="Enabled" Background="Transparent">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="TabApps" Content="Приложения" Tag="0" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;"/></NavigationViewItem.Icon></NavigationViewItem>


    <NavigationViewItem x:Name="TabLogs" Content="Журнал" Tag="3"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabProfileSettings" Content="Настройки профиля" Tag="4"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
  </NavigationView>
  <Grid x:Name="PageHost" Grid.Row="3">
   <Border x:Name="AppsPage" Style="{StaticResource Card}"><Grid RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Приложения профиля" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RuleCount" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
    <ComboBox x:Name="ModeCombo" Grid.Row="1" HorizontalAlignment="Stretch" CornerRadius="8"><ComboBoxItem Content="Только выбранные приложения → VPN"/><ComboBoxItem Content="Все, кроме выбранных → VPN"/><ComboBoxItem Content="Весь интернет → VPN"/></ComboBox>
    <TextBlock x:Name="ModeHint" Grid.Row="2" Style="{StaticResource Muted}" Text="Общая база действует поверх правил приложений. Локальная сеть — напрямую."/>
    <Grid Grid.Row="3" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="AddApp" Content="＋ Добавить приложение" CornerRadius="8"/><Button x:Name="DomainsButton" Grid.Column="1" Content="Домены…" CornerRadius="8"/><Button x:Name="RemoveApps" Grid.Column="2" CornerRadius="8" IsEnabled="False" ToolTipService.ToolTip="Убрать выбранные приложения со всеми компонентами"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="13"/><TextBlock Text="Убрать"/></StackPanel></Button></Grid>
    <ListView x:Name="AppList" Grid.Row="4" SelectionMode="None" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    <TextBlock x:Name="EmptyApps" Grid.Row="4" Text="Добавьте приложения — их трафик будет идти через выбранное подключение." Style="{StaticResource Muted}" Visibility="Collapsed" Margin="8,20" VerticalAlignment="Center"/>
   </Grid></Border>

   <Grid x:Name="SettingsPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" AlwaysShowHeader="False" SelectionFollowsFocus="Enabled" Background="Transparent"><NavigationView.MenuItems><NavigationViewItem x:Name="TabBase" Content="База блокировок" Tag="1"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabSources" Content="Подключения" Tag="2"><NavigationViewItem.Icon><FontIcon Glyph="&#xE705;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabUpdates" Content="Обновления" Tag="5"><NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabStartup" Content="Запуск" Tag="6"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabAbout" Content="О приложении" Tag="7"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems></NavigationView><Grid Grid.Row="1"><Border x:Name="StartupPage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18"><TextBlock Text="Запуск с Windows" Style="{StaticResource SectionTitle}"/><TextBlock Text="Открывать FlowVPN при входе в вашу учётную запись Windows." Style="{StaticResource Muted}"/><ToggleSwitch x:Name="StartupSwitch" Header="Запускать вместе с Windows" OnContent="Включено" OffContent="Выключено"/><ToggleSwitch x:Name="StartupTraySwitch" Header="При автозапуске сворачивать в трей" OnContent="Только значок в области уведомлений" OffContent="Открывать окно приложения"/><TextBlock x:Name="StartupStatus" Style="{StaticResource Muted}"/><Button x:Name="WindowsStartupButton" Content="Автозагрузка в настройках Windows"/><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Автозапуск открывает приложение. VPN подключается вручную; права администратора запрашиваются при подключении."/></StackPanel></ScrollViewer></Border><Border x:Name="AboutPage" Style="{StaticResource Card}" Visibility="Collapsed">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="24" Padding="2">
  <Border CornerRadius="16" Padding="24" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
   <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="68" Height="68" CornerRadius="21" Background="#008A7D" VerticalAlignment="Top"><TextBlock Text="F" FontSize="43" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="FlowVPN" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Ваш маршрут в интернете" FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Spacing="14">
   <TextBlock Text="Разработчик" Style="{StaticResource Muted}"/>
   <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource AccentFillColorSecondaryBrush}"><TextBlock Text="ВС" Foreground="White" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock x:Name="DeveloperName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="@vserdobintsev" Style="{StaticResource Muted}"/></StackPanel>
   </Grid>
  </StackPanel>
  <StackPanel Spacing="10">
   <TextBlock Text="На связи" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Предложения, вопросы и замечания — напишите удобным способом." Style="{StaticResource Muted}"/>
   <HyperlinkButton x:Name="DeveloperGitHub" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" AutomationProperties.Name="GitHub разработчика, vserdobintsev">
    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE943;" FontSize="22"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="GitHub" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><TextBlock Text="github.com/vserdobintsev" Style="{StaticResource Muted}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14"/></Grid>
   </HyperlinkButton>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <HyperlinkButton x:Name="DeveloperMail" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" AutomationProperties.Name="Написать разработчику по электронной почте">
     <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE715;" FontSize="22"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Почта" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><TextBlock x:Name="DeveloperEmail" Style="{StaticResource Muted}"/></StackPanel></Grid>
    </HyperlinkButton>
    <Button x:Name="CopyDeveloperEmail" Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center" CornerRadius="10" ToolTipService.ToolTip="Скопировать адрес" AutomationProperties.Name="Скопировать email разработчика"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button>
   </Grid>
   <HyperlinkButton Content="GNU GPL 3.0 · лицензия" NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" Padding="0,4" FontSize="12"/><TextBlock x:Name="ContactFeedback" FontSize="12" MinHeight="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </StackPanel></ScrollViewer>
</Border><Border x:Name="UpdatesPage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16">
 <TextBlock Text="Обновления FlowVPN" Style="{StaticResource SectionTitle}"/>
 <TextBlock Text="Приложение и движок обновляются вместе — после проверки совместимости." Style="{StaticResource Muted}"/>
 <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="FlowVPN" FontWeight="SemiBold"/><TextBlock x:Name="InstalledAppVersion" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="sing-box" FontWeight="SemiBold"/><TextBlock x:Name="InstalledCoreVersion" TextWrapping="Wrap"/></StackPanel></Grid>
 <ComboBox x:Name="UpdateChannelCombo" Header="Канал выпуска" HorizontalAlignment="Stretch"/>
 <ToggleSwitch x:Name="CheckUpdatesSwitch" Header="Проверять обновления в открытом FlowVPN" OnContent="Автоматически, каждые 8 часов" OffContent="Только вручную"/>
 <TextBlock Text="Фоновая доставка Windows через App Installer настраивается отдельно при установке." Style="{StaticResource Muted}"/>
 <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="16"><StackPanel Spacing="7"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ProgressRing x:Name="AppUpdateProgress" Width="20" Height="20" Visibility="Collapsed"/><TextBlock x:Name="UpdateStatus" Grid.Column="1" TextWrapping="Wrap" FontWeight="SemiBold"/></Grid><TextBlock x:Name="LastUpdateCheck" Style="{StaticResource Muted}"/><TextBlock x:Name="UpdateSourceText" Style="{StaticResource Muted}"/></StackPanel></Border>
 <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="CheckAppUpdateButton" Content="Проверить обновления"/><Button x:Name="CancelAppUpdateButton" Content="Отмена" Visibility="Collapsed"/></StackPanel>
 <TextBlock x:Name="AvailableVersion" FontWeight="SemiBold" TextWrapping="Wrap"/>
 <TextBlock x:Name="UpdateReleaseNotes" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
 <Button x:Name="PrepareUpdateButton" Content="Скачать и подготовить обновление" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"/>
 <Button x:Name="FinishUpdateButton" Content="Завершить для обновления" Visibility="Collapsed"/>
 <InfoBar x:Name="UpdateModeInfo" IsOpen="True" IsClosable="False" Severity="Informational"/>
 </StackPanel></ScrollViewer></Border><Border x:Name="BasePage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18"><StackPanel Spacing="6"><TextBlock Text="Одна база для всех профилей" Style="{StaticResource SectionTitle}"/><TextBlock Text="IP-адреса, подсети и домены выбранной категории направляются через VPN. Дополнительные приложения и сайты настраиваются в профилях." Style="{StaticResource Muted}"/></StackPanel><ToggleSwitch x:Name="BaseSwitch" Header="Общие правила блокировок" OnContent="Включены для всех профилей" OffContent="Выключены для всех профилей"/><Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="16"><StackPanel Spacing="6"><TextBlock Text="RunetFreedom · IP-адреса и домены" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="BaseMetadata" Style="{StaticResource Muted}"/><HyperlinkButton x:Name="DomainRepositoryLink" Content="Источник доменов ↗" HorizontalAlignment="Left" Padding="0,4"/><HyperlinkButton x:Name="RepositoryLink" Content="Источник IP-адресов ↗" HorizontalAlignment="Left" Padding="0,4"/></StackPanel></Border><StackPanel Spacing="8"><TextBox x:Name="DomainCategorySearch" PlaceholderText="Поиск категории" AutomationProperties.Name="Найти доменную категорию"/><ComboBox x:Name="DomainCategoryCombo" Header="Доменная категория" HorizontalAlignment="Stretch"/><TextBlock x:Name="DomainCategoryHint" Style="{StaticResource Muted}"/></StackPanel><Button x:Name="UpdateRulesButton" Content="Обновить из репозитория" CornerRadius="8"/><ToggleSwitch x:Name="AutoUpdateSwitch" Header="Автоматическое обновление" OnContent="Каждые 6 часов при активном VPN" OffContent="Обновлять вручную"/><TextBlock Text="IP-база берётся в готовом формате sing-box. Доменные категории загружаются из того же проекта и проверяются движком. При ошибке сохраняется последняя проверенная копия." Style="{StaticResource Muted}"/><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="IP-база остаётся общей. Здесь выбирается доменная категория для всех профилей. Изменение категории применяется при следующем подключении."/></StackPanel></ScrollViewer></Border>
   <Border x:Name="SourcesPage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16">
    <StackPanel Spacing="6"><TextBlock Text="Подключения" Style="{StaticResource SectionTitle}"/><TextBlock Text="Вставьте ключ или конфигурацию, выберите файл либо укажите параметры сервера. Устанавливать OpenVPN или Outline не нужно." Style="{StaticResource Muted}"/></StackPanel>
    <StackPanel x:Name="SourceCommands" Orientation="Horizontal" Spacing="10"><Button x:Name="AddConnectionButton" Content="Добавить подключение" Style="{StaticResource AccentButtonStyle}" CornerRadius="8"/><Button x:Name="ImportClientsButton" Content="Из установленных клиентов…" CornerRadius="8"/></StackPanel>
    <InfoBar x:Name="EmptySourcesHint" IsOpen="True" IsClosable="False" Severity="Informational" Title="Добавьте первое подключение" Message="FlowVPN определит формат ключа или файла. Данные сервера можно получить у вашего VPN-провайдера или администратора."/>
    <InfoBar x:Name="SourceFeedback" IsOpen="False" IsClosable="True" Severity="Success"/>
    <ListView x:Name="SourceList" HorizontalContentAlignment="Stretch" SelectionMode="Single" MinHeight="130" MaxHeight="330"/>
    <StackPanel x:Name="SourceActions" Orientation="Horizontal" Spacing="10"><Button x:Name="RenameSourceButton" Content="Переименовать" CornerRadius="8"/><Button x:Name="DeleteSourceButton" Content="Удалить" CornerRadius="8"/></StackPanel>
    <TextBlock Text="Ключи хранятся в зашифрованном виде для вашей учётной записи Windows. Динамические ключи Outline обновляются перед подключением." Style="{StaticResource Muted}"/>
   </StackPanel></ScrollViewer></Border>
   </Grid></Grid><Border x:Name="ProfileSettingsPage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18">
 <TextBlock Text="Настройки профиля" Style="{StaticResource SectionTitle}"/>
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="IdentityGlyph" Width="42" Height="42" Background="#172535" CornerRadius="12"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="IdentityName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Название, значок и цвет" Style="{StaticResource Muted}"/></StackPanel><Button x:Name="EditIdentityButton" Grid.Column="2" Content="Изменить" VerticalAlignment="Center"/></Grid>
 <ComboBox x:Name="ProfileSourceCombo" Header="Подключение этого профиля" HorizontalAlignment="Stretch" PlaceholderText="Выберите подключение"/>
 <ComboBox x:Name="ProfileModeCombo" Header="Какие приложения направлять через VPN" HorizontalAlignment="Stretch"><ComboBoxItem Content="Только выбранные приложения → VPN"/><ComboBoxItem Content="Все, кроме выбранных → VPN"/><ComboBoxItem Content="Весь интернет → VPN"/></ComboBox>
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ProfileAppsButton" Content="Приложения профиля" HorizontalAlignment="Stretch"/><Button x:Name="ProfileSitesButton" Grid.Column="1" Content="Сайты через VPN" HorizontalAlignment="Stretch"/></Grid>
 <Button x:Name="ProfileReconnectButton" Content="Переподключить" Visibility="Collapsed"/><TextBlock Text="Правила сохраняются автоматически. При активном подключении примените их кнопкой «Переподключить»." Style="{StaticResource Muted}"/>
