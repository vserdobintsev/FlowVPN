<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid.Resources><Style x:Key="BaseBadgeEnabledStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SidebarNavigationButton" TargetType="Button"><Setter Property="RequestedTheme" Value="Dark"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="12,10"/></Style>
  <Style x:Key="ProfileSettingsCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="ProfileLinkTile" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="12"/></Style>
 </Grid.Resources>
 <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Grid.RowSpan="2" Background="#172535" Padding="18,24,18,18">
  <Grid RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,0,0,12"><Border Width="36" Height="36" CornerRadius="12" Background="#07968B"><TextBlock Text="F" FontSize="23" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel x:Name="BrandLabel"><TextBlock Text="FlowVPN" FontSize="23" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Ваш маршрут в интернете" FontSize="11" Foreground="#9EB2C6" Margin="0,1,0,0"/></StackPanel></StackPanel>
   <TextBlock x:Name="ProfilesCaption" Grid.Row="1" Text="ПРОФИЛИ" FontSize="11" FontWeight="SemiBold" Foreground="#9EB2C6" Margin="8,0,0,0"/>
   <ListView x:Name="ProfileList" Grid.Row="2" SelectionMode="Single" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" RequestedTheme="Dark"/>
   <StackPanel x:Name="SidebarCommands" Grid.Row="3" Spacing="8" Width="212" HorizontalAlignment="Center"><Button x:Name="NewProfile" RequestedTheme="Dark" HorizontalAlignment="Stretch" Background="#25394D" Foreground="White" BorderBrush="#355069" CornerRadius="9" Padding="12,10"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock x:Name="NewProfileText" Text="Новый профиль"/></StackPanel></Button><Button x:Name="ProfileSuggestionsButton" Style="{StaticResource SidebarNavigationButton}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8A5;" FontSize="16" Width="16"/><TextBlock x:Name="ProfileSuggestionsText" Text="Готовые наборы"/></StackPanel></Button><Button x:Name="SettingsButton" Style="{StaticResource SidebarNavigationButton}" ToolTipService.ToolTip="Настройки приложения"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" FontSize="16" Width="16"/><TextBlock x:Name="SettingsText" Text="Настройки"/></StackPanel></Button></StackPanel>
   <StackPanel x:Name="SidebarFooter" Grid.Row="4" Spacing="10" Margin="6,8,0,0"><Button x:Name="ThemeButton" RequestedTheme="Dark" Content="◐  Системная тема" Background="Transparent" BorderThickness="0" Foreground="#9EB2C6" FontSize="12" Padding="0,6"/><TextBlock x:Name="EngineVersionLabel" Text="sing-box · WinUI 3" FontSize="11" Foreground="#8097AD"/></StackPanel>
  </Grid>
 </Border>
 <ScrollViewer x:Name="MainScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><Grid x:Name="MainArea" Padding="28,24,28,16" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="ScopeCaption" Text="ВЫБРАННЫЙ ПРОФИЛЬ" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ProfileHeading" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="BaseBadge" Grid.Column="1" VerticalAlignment="Center" CornerRadius="18" Padding="12,8"  ToolTipService.ToolTip="Общая настройка для всех профилей"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon x:Name="BaseBadgeIcon" Glyph="&#xE73E;" FontSize="12"/><TextBlock x:Name="BaseBadgeText" Text="База включена" FontSize="12"/></StackPanel></Button></Grid>
  <Border x:Name="ConnectionCard" Grid.Row="1" Style="{StaticResource Card}"><Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="10"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#8291A3"/><TextBlock x:Name="StatusText" Text="Отключено" FontSize="21" FontWeight="SemiBold"/><ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/></StackPanel><TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" Text="Подключение запускается вручную"/></StackPanel><Button x:Name="ConnectButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" CornerRadius="10" MinWidth="142" Height="42" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7E8;" FontSize="15"/><TextBlock x:Name="ConnectText" Text="Подключить"/></StackPanel></Button></Grid>
   <Grid x:Name="SourceGrid" Grid.Row="1" HorizontalAlignment="Left" ColumnSpacing="12" RowSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="Подключение" Style="{StaticResource Muted}"/><ComboBox x:Name="SourceCombo" Grid.Row="1" HorizontalAlignment="Stretch" MaxWidth="560" MinWidth="0" CornerRadius="8" PlaceholderText="Выберите OpenVPN или Outline"/><Button x:Name="ApplyButton" Grid.Row="1" Grid.Column="1" Content="Переподключить" CornerRadius="8" ToolTipService.ToolTip="Подключиться с выбранным профилем и сохранёнными правилами"/></Grid>
   <InfoBar x:Name="PendingInfo" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Informational" Message="Изменения сохранены. Переподключитесь, чтобы применить их."/>
  </Grid></Border>
  <NavigationView x:Name="SectionNavigation" Grid.Row="2" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" AlwaysShowHeader="False" SelectionFollowsFocus="Enabled" Background="Transparent">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="TabApps" Content="Приложения" Tag="0" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="TabTraffic" Content="Трафик" Tag="10"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;"/></NavigationViewItem.Icon></NavigationViewItem>


    <NavigationViewItem x:Name="TabLogs" Content="Журнал" Tag="3"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabProfileSettings" Content="Настройки профиля" Tag="4"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
  </NavigationView>
  <Grid x:Name="PageHost" Grid.Row="3">
   <Border x:Name="EmptyProfileState" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
    <FontIcon Glyph="&#xE8A5;" FontSize="36" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <TextBlock Text="Настройте свой маршрут" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="EmptyProfileHint" Style="{StaticResource Muted}"/>
    <StackPanel Spacing="10" HorizontalAlignment="Left"><Button x:Name="EmptyNewProfileButton" Content="Создать профиль" Style="{StaticResource AccentButtonStyle}" CornerRadius="8"/><Button x:Name="EmptyProfileSuggestionsButton" Content="Готовые профили…" CornerRadius="8"/><Button x:Name="EmptyAddConnectionButton" Content="Добавить подключение" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" Visibility="Collapsed"/></StackPanel>
    <TextBlock Text="VPN запустится только по кнопке «Подключить»." Style="{StaticResource Muted}"/>
   </StackPanel></Border>
   <ScrollViewer x:Name="TrafficPage" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Spacing="16">
    <Border x:Name="TrafficEmpty" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE9D2;" FontSize="32" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="TrafficEmptyTitle" Text="Трафик появится после подключения" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TrafficEmptyHint" Style="{StaticResource Muted}"/><Button x:Name="TrafficActiveProfileButton" Content="Перейти к активному профилю" HorizontalAlignment="Left" CornerRadius="8" Visibility="Collapsed"/></StackPanel></Border>
    <StackPanel x:Name="TrafficContent" Spacing="16" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
      <TextBlock Text="Трафик сеанса" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Весь трафик, обработанный sing-box: через VPN и напрямую." Style="{StaticResource Muted}"/>
      <Grid x:Name="TrafficOverview" ColumnSpacing="24" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74B;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Приём" Style="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="TrafficDownloadSpeed" Text="—" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="TrafficDownloadTotal" Style="{StaticResource Muted}"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74A;" FontSize="13"/><TextBlock Text="Отправка" Style="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="TrafficUploadSpeed" Text="—" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="TrafficUploadTotal" Style="{StaticResource Muted}"/></StackPanel>
      </Grid>
      <TextBlock x:Name="TrafficSessionInfo" Style="{StaticResource Muted}"/>
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="TrafficRange" SelectedIndex="1" Width="130" AutomationProperties.Name="Диапазон графика"><ComboBoxItem Content="1 минута" Tag="1"/><ComboBoxItem Content="5 минут" Tag="5"/><ComboBoxItem Content="15 минут" Tag="15"/></ComboBox><Button x:Name="TrafficPause" Grid.Column="1" Content="Пауза просмотра" CornerRadius="8" ToolTipService.ToolTip="Остановить просмотр. Сбор данных продолжится."/></Grid>
      <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="12">
       <StackPanel Spacing="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TrafficScale" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="Байт в секунду" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
        <ContentControl x:Name="TrafficChart" IsTabStop="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="График приёма и отправки. Стрелки влево и вправо — значения по секундам; Home и End — края диапазона.">
         <Grid x:Name="TrafficPlot" Height="190" Background="Transparent">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/><Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/><Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/><Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1"/>
          <Canvas x:Name="TrafficCanvas" Grid.RowSpan="4" IsHitTestVisible="False">
           <Path x:Name="TrafficDownloadArea" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0.08"/>
           <Path x:Name="TrafficUploadArea" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.04"/>
           <Path x:Name="TrafficDownloadLine" Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2"/>
           <Path x:Name="TrafficUploadLine" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.7" StrokeDashArray="4,3"/>
           <Line x:Name="TrafficCursor" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" Visibility="Collapsed"/>
          </Canvas>
          <TextBlock x:Name="TrafficChartHint" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Ожидаем измерения…" Style="{StaticResource Muted}" TextAlignment="Center"/>
          <Border x:Name="TrafficHover" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,7" Margin="6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed"><TextBlock x:Name="TrafficHoverText" FontSize="12" TextWrapping="Wrap"/></Border>
         </Grid>
        </ContentControl>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TrafficAxisStart" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="TrafficAxisEnd" Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
       </StackPanel>
      </Border>
      <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="7"><Rectangle Width="20" Height="2" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Приём" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"><TextBlock Text="┄┄" FontWeight="SemiBold"/><TextBlock Text="Отправка" FontSize="12"/></StackPanel></Grid>
      <TextBlock x:Name="TrafficViewStatus" Style="{StaticResource Muted}"/>
     </StackPanel></Border>
     <Expander x:Name="TrafficDetails" Header="Активные соединения" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="12">
       <TextBlock x:Name="TrafficDetailsHint" Style="{StaticResource Muted}" Text="Здесь только открытые соединения. Их объём не равен полному объёму сеанса."/>
       <Button x:Name="CoreConnectionsButton" HorizontalAlignment="Left" CornerRadius="8" AutomationProperties.Name="Управление соединениями" AutomationProperties.HelpText="Просмотр активных соединений и закрытие выбранного. Доступно при работающем VPN." ToolTipService.ToolTip="Просмотр активных соединений и закрытие выбранного. Доступно при работающем VPN."><TextBlock Text="Управление соединениями" TextWrapping="Wrap"/></Button>
       <InfoBar x:Name="TrafficConnectionsCoverage" IsOpen="False" IsClosable="False" Severity="Informational"/>
       <Grid x:Name="TrafficDetailsControls" ColumnSpacing="10" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox x:Name="TrafficGrouping" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Группировать соединения"><ComboBoxItem Content="По приложениям"/><ComboBoxItem Content="По адресам"/></ComboBox><ComboBox x:Name="TrafficSort" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Сортировать соединения"><ComboBoxItem Content="По общему объёму"/><ComboBoxItem Content="По приёму"/><ComboBoxItem Content="По отправке"/></ComboBox><TextBox x:Name="TrafficSearch" Grid.Row="1" Grid.ColumnSpan="2" PlaceholderText="Приложение, домен, IP или маршрут" AutomationProperties.Name="Найти активные соединения"/></Grid>
       <TextBlock x:Name="TrafficConnectionsSummary" Style="{StaticResource Muted}"/>
       <StackPanel x:Name="TrafficGroups" Spacing="8"/>
       <TextBlock x:Name="TrafficConnectionsEmpty" Text="Сейчас нет активных соединений." Style="{StaticResource Muted}"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </StackPanel></ScrollViewer>
   <Border x:Name="AppsPage" Style="{StaticResource Card}"><ScrollViewer x:Name="AppsPageScroll" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><Grid x:Name="AppsContent" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Приложения профиля" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RuleCount" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
    <ComboBox x:Name="ModeCombo" Grid.Row="1" HorizontalAlignment="Left" MaxWidth="560" CornerRadius="8"><ComboBoxItem Content="Только выбранные приложения → VPN"/><ComboBoxItem Content="Все, кроме выбранных → VPN"/><ComboBoxItem Content="Весь интернет → VPN"/></ComboBox>
    <TextBlock x:Name="ModeHint" Grid.Row="2" Style="{StaticResource Muted}" Text="Общая база действует поверх правил приложений. Локальная сеть — напрямую."/>
    <Grid Grid.Row="3" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="AddApp" Content="＋ Добавить приложение" CornerRadius="8"/><Button x:Name="DomainsButton" Grid.Column="1" Content="Домены…" CornerRadius="8"/><Button x:Name="RemoveApps" Grid.Column="2" CornerRadius="8" IsEnabled="False" ToolTipService.ToolTip="Убрать выбранные приложения со всеми компонентами"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="13"/><TextBlock Text="Убрать"/></StackPanel></Button></Grid>
    <ListView x:Name="AppList" Grid.Row="4" SelectionMode="None" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    <TextBlock x:Name="EmptyApps" Grid.Row="4" Text="В этом профиле пока нет приложений." Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,4,0,0" VerticalAlignment="Top"/>
   </Grid></ScrollViewer></Border>

   <Grid x:Name="SettingsPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" AlwaysShowHeader="False" SelectionFollowsFocus="Enabled" Background="Transparent"><NavigationView.MenuItems><NavigationViewItem x:Name="TabBase" Content="База блокировок" Tag="1"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabSources" Content="Подключения" Tag="2"><NavigationViewItem.Icon><FontIcon Glyph="&#xE705;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabModules" Content="Модули" Tag="9"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabUpdates" Content="Обновления" Tag="5"><NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabStartup" Content="Запуск" Tag="6"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="TabAbout" Content="О приложении" Tag="7"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems></NavigationView><Grid Grid.Row="1"><Border x:Name="StartupPage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer x:Name="StartupScroll" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left"><StackPanel x:Name="StartupContent" Width="600" MaxWidth="960" HorizontalAlignment="Left" Spacing="18"><TextBlock Text="Запуск с Windows" Style="{StaticResource SectionTitle}"/><TextBlock Text="Открывать FlowVPN при входе в вашу учётную запись Windows." Style="{StaticResource Muted}"/><ToggleSwitch x:Name="StartupSwitch" Header="Запускать вместе с Windows" OnContent="Включено" OffContent="Выключено"/><ToggleSwitch x:Name="StartupTraySwitch" Header="При автозапуске сворачивать в трей" OnContent="Только значок в области уведомлений" OffContent="Открывать окно приложения"/><TextBlock x:Name="StartupStatus" Style="{StaticResource Muted}"/><Button x:Name="WindowsStartupButton" Content="Автозагрузка в настройках Windows"/><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Автозапуск открывает приложение. VPN подключается вручную; права администратора запрашиваются при подключении."/></StackPanel></ScrollViewer></Border><Border x:Name="AboutPage" Style="{StaticResource Card}" Visibility="Collapsed">
 <ScrollViewer x:Name="AboutScroll" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left"><StackPanel x:Name="AboutContent" Width="600" MaxWidth="960" HorizontalAlignment="Left" Spacing="24" Padding="2">
  <Border CornerRadius="16" Padding="24" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
   <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="68" Height="68" CornerRadius="21" Background="#008A7D" VerticalAlignment="Top"><TextBlock Text="F" FontSize="43" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="FlowVPN" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Ваш маршрут в интернете" FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Spacing="14">
   <TextBlock Text="Разработчик" Style="{StaticResource Muted}"/>
   <Grid x:Name="DeveloperIdentityRow" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <PersonPicture x:Name="DeveloperAvatar" Initials="ВС" Width="44" Height="44" VerticalAlignment="Center"/>
    <StackPanel x:Name="DeveloperIdentity" Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="DeveloperName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextLineBounds="TrimToCapHeight"/><TextBlock x:Name="DeveloperHandle" Text="@vserdobintsev" Style="{StaticResource Muted}" TextLineBounds="TrimToCapHeight"/></StackPanel>
   </Grid>
  </StackPanel>
  <StackPanel Spacing="10">
