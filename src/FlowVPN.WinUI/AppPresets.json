  {
    "Id": "nvidia-app",
    "Name": "NVIDIA App",
    "Description": "Приложение, оверлей и общий NVIDIA Container. Контейнер может обслуживать другие функции NVIDIA.",
    "Components": [
      {
        "Name": "Приложение, обновления и оверлей",
        "Executable": "CEF\\NVIDIA App.exe",
        "Locations": [
          "{ProgramFiles}\\NVIDIA Corporation\\NVIDIA app",
          "{ProgramFilesX86}\\NVIDIA Corporation\\NVIDIA app"
        ]
      },
      {
        "Name": "NVIDIA Container — общая служба NVIDIA",
        "Executable": "nvcontainer.exe",
        "FileOnly": true,
        "RequiresAnyFile": [
          "{ProgramFiles}\\NVIDIA Corporation\\NVIDIA app\\CEF\\NVIDIA App.exe",
          "{ProgramFilesX86}\\NVIDIA Corporation\\NVIDIA app\\CEF\\NVIDIA App.exe"
        ],
        "Locations": [
          "{ProgramFiles}\\NVIDIA Corporation\\NvContainer",
          "{ProgramFilesX86}\\NVIDIA Corporation\\NvContainer"
        ],
        "Role": "shared-service",
        "ScopeNote": "Этот EXE также обслуживает другие функции NVIDIA; правило охватывает все его экземпляры."
      }
    ],
    "ProfileIcon": "game"
  },
