  {
    "Id": "kilo",
    "Name": "Kilo Code",
    "Description": "Настольное приложение и отдельный CLI. Расширения находятся внутри соответствующего приложения.",
    "Components": [
      {
        "Name": "Настольное приложение",
        "Executable": "Kilo.exe",
        "Registration": "^Kilo(?: Code| Desktop)?(?:\\s|$)",
        "Locations": [
          "{LocalAppData}\\Programs\\Kilo",
          "{LocalAppData}\\Programs\\Kilo Code",
          "{ProgramFiles}\\Kilo"
        ]
      },
      {
        "Name": "Kilo CLI",
        "Executable": "kilo.exe",
        "FileOnly": true,
        "Recursive": true,
        "SearchPath": true,
        "Locations": [
          "{AppData}\\npm\\node_modules\\@kilocode",
          "{UserProfile}\\.bun\\install\\global\\node_modules\\@kilocode",
          "{UserProfile}\\.kilo\\bin",
          "{UserProfile}\\scoop\\apps\\kilo\\current"
        ],
        "Role": "engine"
      }
    ],
    "IconFiles": [],
    "ProfileIcon": "code"
  },
  {
    "Id": "opencode",
