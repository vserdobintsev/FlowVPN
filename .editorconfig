root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,xaml,csproj,slnx}]
indent_size = 2
end_of_line = lf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

# These scripts also run in Windows PowerShell 5.1, which needs a BOM for Russian text.
[src/FlowVPN.WinUI/Distribution/{Install-FlowVPN,Test-PackagePayload,Test-PackagePayloadChecks}.ps1]
charset = utf-8-bom

[*.cs]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
dotnet_sort_system_directives_first = true

[**/obj/**]
generated_code = true

[**/bin/**]
generated_code = true
